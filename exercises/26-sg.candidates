% Lesson 26, exercise 3: programs/sg.candidates without the rule the
% answer needs.
%
%   python3 synthesis.py programs/kinship.dl --examples programs/sg.examples --candidates exercises/26-sg.candidates -t


sg(X, X) :- parent(X, Y).
sg(X, X) :- parent(Y, X).
sg(X, Y) :- sg(Y, X).
sg(X, Y) :- parent(P, X), parent(P, Y).
sg(X, Y) :- parent(X, P), parent(Y, P).
sg(X, Y) :- sg(X, Z), sg(Z, Y).
sg(X, Y) :- parent(X, P), parent(Y, Q), sg(P, Q).
sg(X, Y) :- parent(P, X), sg(P, Y).
