% Lesson 8 — runnable answer (exercise 1): routes.dl plus one new cheap
% route a -> d, so the three semirings can be compared on path(a, e):
%   python3 semiring.py -s minplus -q 'path(a, e)' exercises/08-answers.dl
%   python3 semiring.py -s count   -q 'path(a, e)' exercises/08-answers.dl
%   python3 semiring.py -s why     -q 'path(a, e)' exercises/08-answers.dl

edge(a, b) @ 1.
edge(a, c) @ 2.
edge(b, c) @ 1.
edge(b, d) @ 4.
edge(c, d) @ 2.
edge(d, e) @ 3.
edge(a, d) @ 3.          % the new direct route

path(X, Y) :- edge(X, Y).
path(X, Z) :- edge(X, Y), path(Y, Z).
