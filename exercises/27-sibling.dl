% Lesson 27, exercise 5: lesson 1's family tree with the sibling rule
% repaired by a comparison.
%
%   python3 mutation.py exercises/27-sibling.dl -v

parent(abe, bob).
parent(abe, ann).
parent(bob, carl).
parent(ann, dana).
grandparent(X, Z) :- parent(X, Y), parent(Y, Z).
sibling(X, Y) :- parent(P, X), parent(P, Y), X != Y.
ancestor(X, Y) :- parent(X, Y).
ancestor(X, Z) :- parent(X, Y), ancestor(Y, Z).
