% two queens D columns apart are compatible unless they attack
ok(R1, D, R2) :- row(R1), row(R2), dist(D), not attacks(R1, D, R2).

% queensK: compatible queens in the first K columns
queens1(X0) :- row(X0).
queens2(X0, X1) :- queens1(X0), next2(X0, X1).
queens3(X0, X1, X2) :- queens2(X0, X1), next3(X0, X1, X2).
queens4(X0, X1, X2, X3) :- queens3(X0, X1, X2), next4(X0, X1, X2, X3).
queens5(X0, X1, X2, X3, X4) :- queens4(X0, X1, X2, X3), next5(X0, X1, X2, X3, X4).
queens6(X0, X1, X2, X3, X4, X5) :- queens5(X0, X1, X2, X3, X4), next6(X0, X1, X2, X3, X4, X5).
queens7(X0, X1, X2, X3, X4, X5, X6) :- queens6(X0, X1, X2, X3, X4, X5), next7(X0, X1, X2, X3, X4, X5, X6).
queens8(X0, X1, X2, X3, X4, X5, X6, X7) :- queens7(X0, X1, X2, X3, X4, X5, X6), next8(X0, X1, X2, X3, X4, X5, X6, X7).

% nextK: the last queen is compatible with every earlier one
next2(X0, X1) :- queens1(X1), ok(X0, d1, X1).
next3(X0, X1, X2) :- next2(X1, X2), ok(X0, d2, X2).
next4(X0, X1, X2, X3) :- next3(X1, X2, X3), ok(X0, d3, X3).
next5(X0, X1, X2, X3, X4) :- next4(X1, X2, X3, X4), ok(X0, d4, X4).
next6(X0, X1, X2, X3, X4, X5) :- next5(X1, X2, X3, X4, X5), ok(X0, d5, X5).
next7(X0, X1, X2, X3, X4, X5, X6) :- next6(X1, X2, X3, X4, X5, X6), ok(X0, d6, X6).
next8(X0, X1, X2, X3, X4, X5, X6, X7) :- next7(X1, X2, X3, X4, X5, X6, X7), ok(X0, d7, X7).
