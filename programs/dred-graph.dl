% The DRed demo graph — a chain with a shortcut.  Deleting edge(n3, n4)
% implicates seven facts (the edge itself plus six paths); four of the
% paths survive via the n2 -> n4 shortcut and are re-derived.  Used by
% `python3 incremental.py` and lesson 10.

edge(n1, n2).  edge(n2, n3).  edge(n3, n4).  edge(n4, n5).
edge(n2, n4).                 % alternative route around n3

path(X, Y) :- edge(X, Y).
path(X, Z) :- edge(X, Y), path(Y, Z).
