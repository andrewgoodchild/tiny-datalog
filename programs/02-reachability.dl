% Transitive closure — a pure demo of semi-naive evaluation.
% Run with --trace to watch the per-round delta shrink as path lengths
% grow, instead of the whole relation being recomputed every round.

edge(n1, n2).  edge(n2, n3).  edge(n3, n4).  edge(n4, n5).
edge(n5, n6).  edge(n6, n7).  edge(n7, n8).
edge(n3, n9).  edge(n9, n10).

path(X, Y) :- edge(X, Y).
path(X, Z) :- edge(X, Y), path(Y, Z).
