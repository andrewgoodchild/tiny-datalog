% A KL-ONE-style family ontology in the EL concept language.
%
%   python3 subsumption.py programs/family-ontology.dl          classify
%   python3 subsumption.py --emit programs/family-ontology.dl   the Datalog
%   python3 subsumption.py -q grandfather programs/family-ontology.dl
%
% isa/2    = necessary condition only (a "primitive" concept)
% define/2 = necessary AND sufficient (a "defined" concept — the
%            classifier can discover what it falls under)
%
% The classifier should discover, unaided: every parent is a person,
% every father is a parent, and every grandfather is a father.

role(has_child).

isa(man, person).
isa(woman, person).

define(parent,      and(person, some(has_child, person))).
define(father,      and(man,    some(has_child, person))).
define(mother,      and(woman,  some(has_child, person))).
define(grandfather, and(man,    some(has_child, parent))).
