% The policy of 00-eligibility.dl, plus a rule every scheme has: only
% one member of a household may claim.
%
%   python3 datalog.py programs/eligibility-choice.dl     (rejected)
%   python3 datalog.py --models programs/eligibility-choice.dl
%
% This is not a contradiction — it is a SILENCE.  The rule says one
% claimant per household without saying which one, and for oak_house
% either member would do.  So unlike the paradox program this one has
% stable models: two of them, one per candidate.
%
% The engine cannot choose, and should not: which member claims is a
% policy question (oldest? lowest income? first to apply?).  What it
% can do is find the fork, name both branches, and tell you a rule is
% missing — which is the useful failure.
%
% Note the distinct/2 facts: the engine has no built-in !=, so
% "somebody other than P" has to be spelled out in data.  That is a
% deliberate omission, explained in the README under "Deliberately
% missing".

member(bob,   oak_house).
member(cyril, oak_house).
member(dana,  elm_house).
member(edith, elm_house).

receives_pension(cyril).
employed(dana).
carer(edith, cyril).

distinct(bob, cyril).    distinct(cyril, bob).
distinct(dana, edith).   distinct(edith, dana).

qualifying_household(H) :- member(P, H), receives_pension(P).
qualifying_household(H) :- member(P, H), carer(P, Q), receives_pension(Q).

other_claimant(P) :- member(P, H), member(Q, H), eligible(Q), distinct(P, Q).

eligible(P) :- member(P, H), qualifying_household(H),
               not employed(P), not other_claimant(P).
